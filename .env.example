# ---- Gig Radar config ----
# Copy this file to ".env" and fill in what you have. Everything is optional:
# with no tokens, the 6 public feeds still work. Add tokens to unlock more.

# Poll loop (seconds). 1200 = every 20 min. Don't go below 300.
POLL_INTERVAL=1200
# Local dashboard port
PORT=8787

# ---- Email alerts (Gmail) ----
# Create a Gmail "App Password": https://myaccount.google.com/apppasswords
# (needs 2FA on). Use that 16-char password here, NOT your normal password.
SMTP_USER=
SMTP_APP_PASSWORD=
NOTIFY_EMAIL_TO=

# ---- SMS alerts (optional, Twilio free trial) ----
# https://www.twilio.com/try-twilio  -> SID, Auth Token, a trial "from" number.
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_TO=

# ---- Reddit r/forhire (optional) ----
# Make a "script" app: https://www.reddit.com/prefs/apps -> create app -> script.
# Only the client id + secret are needed (app-only read). No password stored.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ---- Freelancer.com (optional) ----
# Get an OAuth token: https://accounts.freelancer.com/settings/develop
FREELANCER_OAUTH_TOKEN=

# ---- Upwork (optional, ADVANCED) ----
# Upwork's public API needs an approved key + OAuth2; access is gated and often
# not granted to individuals. If you obtain an access token, paste it here.
# If it fails, the app just skips Upwork gracefully.
UPWORK_ACCESS_TOKEN=
